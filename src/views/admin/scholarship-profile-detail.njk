{% extends "layouts/admin.njk" %}

{% block title %}Detail Profil — {{ profile.fullName }} — ISF{% endblock %}

{% block breadcrumb %}
<a href="/admin" class="admin-breadcrumb__link">Admin</a>
<span class="admin-breadcrumb__sep">/</span>
<a href="/admin/scholarship" class="admin-breadcrumb__link">Beasiswa</a>
<span class="admin-breadcrumb__sep">/</span>
<a href="/admin/scholarship/profiles" class="admin-breadcrumb__link">Profil</a>
<span class="admin-breadcrumb__sep">/</span>
<span class="admin-breadcrumb__current">{{ profile.fullName }}</span>
{% endblock %}

{% block body %}
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">{{ profile.fullName }}</h1>
    <p class="admin-page-lead">
      Status:
      <span class="status-badge status-badge--{{ profile.verificationStatus | lower | replace('_', '-') }}">
        {{ profile.verificationStatus | replace('_', ' ') }}
      </span>
    </p>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;max-width:900px;">
  <div class="owner-section">
    <h2 class="owner-section__title">Identitas Diri</h2>
    <dl style="display:grid;gap:0.5rem;">
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Nama Lengkap</dt><dd>{{ profile.fullName }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Nomor Telepon</dt><dd>{{ profile.phoneNumber or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Tanggal Lahir</dt><dd>{{ profile.dateOfBirth or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Kota</dt><dd>{{ profile.city or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Provinsi</dt><dd>{{ profile.province or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Alamat</dt><dd style="white-space:pre-line;">{{ profile.address or '—' }}</dd>
    </dl>
  </div>
  <div class="owner-section">
    <h2 class="owner-section__title">Informasi Akademik</h2>
    <dl style="display:grid;gap:0.5rem;">
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Universitas</dt><dd>{{ profile.universityName or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Fakultas</dt><dd>{{ profile.faculty or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Program Studi</dt><dd>{{ profile.studyProgram or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Jenjang</dt><dd>{{ profile.degreeLevel or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">NIM</dt><dd>{{ profile.studentIdNumber or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Semester</dt><dd>{{ profile.currentSemester or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Tahun Masuk</dt><dd>{{ profile.enrollmentYear or '—' }}</dd>
      <dt style="font-size:0.78rem;color:var(--color-text-muted);">Status</dt><dd>{{ profile.studentStatus or '—' }}</dd>
    </dl>
  </div>
</div>

{% if profile.verificationStatus === 'PENDING_VERIFICATION' %}
<div class="owner-section" style="margin-top:1.5rem;max-width:560px;">
  <h2 class="owner-section__title">Keputusan Verifikasi</h2>
  <form id="verifyForm">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="form-group" style="margin-bottom:1rem;">
      <label class="form-label" for="verifyNotes">Catatan (opsional)</label>
      <textarea id="verifyNotes" name="notes" class="form-input" rows="3" maxlength="500"
                placeholder="Catatan untuk mahasiswa terkait keputusan ini..."></textarea>
    </div>
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
      <button type="button" id="btnApprove" class="btn btn--primary">✓ Verifikasi</button>
      <button type="button" id="btnReject" class="btn btn--ghost" style="border-color:var(--red-400);color:var(--red-400);">✗ Minta Perubahan</button>
      <span id="verifyStatus" style="font-size:0.85rem;color:var(--color-text-muted);align-self:center;"></span>
    </div>
  </form>
</div>
{% endif %}

{% if profile.verificationNotes %}
<div class="alert alert--info" style="margin-top:1rem;max-width:560px;">
  <strong>Catatan Verifikasi Terakhir:</strong> {{ profile.verificationNotes }}
</div>
{% endif %}

<script>
(function() {
  const csrf = '{{ csrfToken }}';
  const profileId = '{{ profile.id }}';

  function doVerify(approved) {
    const notes = document.getElementById('verifyNotes')?.value;
    const status = document.getElementById('verifyStatus');
    document.getElementById('btnApprove').disabled = true;
    document.getElementById('btnReject').disabled = true;
    status.textContent = 'Memproses…';

    fetch('/api/v1/scholarship/admin/profiles/' + profileId + '/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
      body: JSON.stringify({ approved, notes }),
    }).then(r => r.json()).then(json => {
      if (json.profile) {
        status.textContent = approved ? 'Profil diverifikasi.' : 'Perubahan diminta.';
        status.style.color = approved ? 'var(--color-success-text)' : 'var(--red-400)';
        setTimeout(() => location.reload(), 1200);
      } else {
        status.textContent = json.error || 'Gagal.'; status.style.color = 'var(--red-400)';
        document.getElementById('btnApprove').disabled = false;
        document.getElementById('btnReject').disabled = false;
      }
    }).catch(() => {
      status.textContent = 'Kesalahan jaringan.'; status.style.color = 'var(--red-400)';
      document.getElementById('btnApprove').disabled = false;
      document.getElementById('btnReject').disabled = false;
    });
  }

  document.getElementById('btnApprove')?.addEventListener('click', () => doVerify(true));
  document.getElementById('btnReject')?.addEventListener('click', () => doVerify(false));
})();
</script>
{% endblock %}
