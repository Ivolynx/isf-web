{% extends "layouts/admin.njk" %}

{% block title %}Reviewer Area — ISF{% endblock %}

{% block breadcrumb %}
<span class="admin-breadcrumb__current">Reviewer</span>
{% endblock %}

{% block body %}
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Reviewer Area</h1>
    <p class="admin-page-lead">Selamat datang, {{ displayName or userEmail }}. Tinjau dan setujui artikel serta konten platform ISF.</p>
  </div>
  <a href="/admin/cms/review" class="btn btn--primary btn--sm">Antrean Review →</a>
</div>

<div class="admin-stats-row">
  <div class="admin-stat-card">
    <div class="admin-stat-card__label">Role</div>
    <div class="admin-stat-card__value" style="font-size:1rem;padding-top:0.3rem;">REVIEWER</div>
    <div class="admin-stat-card__sub">Reviewer konten</div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-card__label">Akun</div>
    <div class="admin-stat-card__value" style="font-size:0.82rem;padding-top:0.3rem;word-break:break-all;">{{ userEmail }}</div>
  </div>
</div>

<h2 style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted,#5C6E74);margin-bottom:0.85rem;">Akses Cepat</h2>
<div class="admin-quick-grid">

  <a href="/admin/cms/review" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="admin-quick-card__title">Antrean Review</div>
    <div class="admin-quick-card__desc">Tinjau artikel yang menunggu persetujuan dari editor.</div>
  </a>

  <a href="/admin/fundraising/review" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
    </div>
    <div class="admin-quick-card__title">Review Kampanye</div>
    <div class="admin-quick-card__desc">Tinjau kampanye fundraising yang menunggu persetujuan.</div>
  </a>

  <a href="/admin/cms" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg>
    </div>
    <div class="admin-quick-card__title">CMS Dashboard</div>
    <div class="admin-quick-card__desc">Lihat semua artikel yang tersedia di sistem CMS.</div>
  </a>

  <a href="/admin/scholarship/profiles" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="admin-quick-card__title">Verifikasi Profil</div>
    <div class="admin-quick-card__desc">Verifikasi profil mahasiswa yang mengajukan beasiswa.</div>
  </a>

  <a href="/admin/scholarship/payments" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
    </div>
    <div class="admin-quick-card__title">Verifikasi Pembayaran</div>
    <div class="admin-quick-card__desc">Verifikasi bukti pembayaran cicilan mahasiswa.</div>
  </a>

  <a href="/blog" target="_blank" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
    </div>
    <div class="admin-quick-card__title">Blog Publik ↗</div>
    <div class="admin-quick-card__desc">Lihat blog publik ISF yang sudah diterbitkan.</div>
  </a>

</div>
{% endblock %}
