{% extends "layouts/admin.njk" %}

{% block title %}Manajemen Beasiswa & Pembiayaan — ISF{% endblock %}

{% block breadcrumb %}
<a href="/admin" class="admin-breadcrumb__link">Admin</a>
<span class="admin-breadcrumb__sep">/</span>
<span class="admin-breadcrumb__current">Beasiswa &amp; Pembiayaan</span>
{% endblock %}

{% block body %}
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Beasiswa &amp; Pembiayaan Mahasiswa</h1>
    <p class="admin-page-lead">Kelola profil mahasiswa, pengajuan beasiswa, dan pembiayaan student loan.</p>
  </div>
</div>

<div class="alert alert--info" style="margin-bottom:1.5rem;padding:0.75rem 1rem;font-size:0.875rem;">
  <strong>Mode Simulasi Aktif:</strong> Seluruh modul pembiayaan berjalan dalam mode simulasi. Tidak ada transaksi keuangan nyata yang aktif.
</div>

{% if dbError %}
<div class="alert alert--warning" style="margin-bottom:1.5rem;">{{ dbError }}</div>
{% endif %}

<div class="admin-quick-grid">
  <a href="/admin/scholarship/profiles" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
    </div>
    <div class="admin-quick-card__title">Verifikasi Profil</div>
    <div class="admin-quick-card__desc">
      Tinjau dan verifikasi profil mahasiswa.
      {% if pendingProfiles > 0 %}<span class="badge">{{ pendingProfiles }}</span>{% endif %}
    </div>
  </a>

  <a href="/admin/scholarship/loans" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
    </div>
    <div class="admin-quick-card__title">Pengajuan Pembiayaan</div>
    <div class="admin-quick-card__desc">
      Tinjau dan setujui pengajuan student loan.
      {% if pendingLoans > 0 %}<span class="badge">{{ pendingLoans }}</span>{% endif %}
    </div>
  </a>

  <a href="/admin/scholarship/payments" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
    </div>
    <div class="admin-quick-card__title">Verifikasi Pembayaran</div>
    <div class="admin-quick-card__desc">
      Tinjau bukti pembayaran cicilan yang masuk.
      {% if pendingPayments > 0 %}<span class="badge">{{ pendingPayments }}</span>{% endif %}
    </div>
  </a>
</div>
{% endblock %}
