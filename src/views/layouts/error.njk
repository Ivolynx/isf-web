<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}ISF — Kesalahan{% endblock %}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/css/design-tokens.css">
  <script>
    (function(){var t=localStorage.getItem('isf-theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.setAttribute('data-theme','dark');}})();
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body {
      font-family: var(--font-body, "Plus Jakarta Sans", system-ui, sans-serif);
      background: var(--color-bg, #F4F2F2);
      color: var(--color-text, #1D2128);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2rem;
    }
    .error-card {
      max-width: 480px;
      width: 100%;
      text-align: center;
    }
    .error-mark {
      display: inline-grid;
      place-items: center;
      width: 5rem; height: 5rem;
      border: 1.5px solid var(--color-primary, #215E61);
      border-radius: 50%;
      font-family: var(--font-display, "Newsreader", Georgia, serif);
      font-size: 2rem;
      font-weight: 600;
      color: var(--color-primary, #215E61);
      margin-bottom: 2rem;
    }
    .error-code {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-accent, #E08A10);
      margin-bottom: 0.75rem;
    }
    .error-title {
      font-family: var(--font-display, "Newsreader", Georgia, serif);
      font-size: clamp(1.6rem, 5vw, 2.4rem);
      font-weight: 500;
      line-height: 1.1;
      margin: 0 0 1rem;
      color: var(--color-text, #1D2128);
    }
    .error-message {
      color: var(--color-text-secondary, #3A5057);
      font-size: 1rem;
      line-height: 1.65;
      margin: 0 0 2rem;
    }
    .error-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 0.85rem 1.75rem;
      border-radius: 999px;
      font-weight: 600; font-size: 0.95rem;
      border: 1.5px solid transparent;
      text-decoration: none;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn--primary {
      background: var(--color-primary, #215E61);
      color: #FFFFFF;
      border-color: var(--color-primary, #215E61);
    }
    .btn--primary:hover {
      background: var(--color-primary-hover, #194749);
      border-color: var(--color-primary-hover, #194749);
    }
    .btn--ghost {
      background: transparent;
      color: var(--color-text, #1D2128);
      border-color: var(--color-border, #DDE0E0);
    }
    .btn--ghost:hover {
      border-color: var(--color-primary, #215E61);
      color: var(--color-primary, #215E61);
      background: var(--color-primary-light, #D5E8E9);
    }
    .req-id {
      margin-top: 2.5rem;
      font-size: 0.75rem;
      color: var(--color-text-muted, #5C6E74);
      font-family: monospace;
    }
  </style>
</head>
<body>
  <div class="error-card">
    <div class="error-mark" aria-hidden="true">I</div>
    {% block content %}{% endblock %}
    {% if requestId %}
    <p class="req-id">Request ID: {{ requestId }}</p>
    {% endif %}
  </div>
</body>
</html>
