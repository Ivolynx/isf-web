{% extends "layouts/base.njk" %}

{% block title %}Forgot Password — ISF{% endblock %}

{% block body %}
<div class="auth-page">
  <header class="auth-header">
    <a class="brand" href="/" aria-label="Intelligentsia Scholarship Fund home">
      <span class="brand__mark" aria-hidden="true">I</span>
      <span>
        <span class="brand__name">ISF</span>
        <span class="brand__sub">Intelegensia</span>
      </span>
    </a>
    <nav class="auth-header__nav" aria-label="Account options">
      <a href="/auth/login">Back to sign in</a>
      <button class="theme-toggle" type="button" aria-label="Ganti tema" title="Light / Dark Mode">
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
    </nav>
  </header>

  <main class="auth-main" id="main-content">
    <div class="auth-card">
      <p class="auth-card__eyebrow">Account recovery</p>
      <h1 class="auth-card__title">Reset your password</h1>
      <p class="auth-card__subtitle">
        Enter your email address and we&rsquo;ll send you a reset link if an account exists.
      </p>

      {% if sent %}
      <div class="alert alert--success" role="status">
        If an account with that email exists, a password reset link has been sent.
        Please check your inbox.
      </div>
      {% endif %}

      {% if not sent %}
      <form method="POST" action="/auth/forgot-password" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <label class="form-label form-label--required" for="email">Email address</label>
          <input
            class="form-input"
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            autocapitalize="none"
            spellcheck="false"
            required
          >
        </div>

        <button class="btn btn--primary btn--full" type="submit">Send reset link</button>
      </form>
      {% endif %}

      <div class="auth-links">
        <a href="/auth/login">Back to sign in</a>
      </div>
    </div>
  </main>

  <footer class="auth-footer">
    &copy; {{ year }} Intelligentsia Scholarship Fund. All rights reserved.
  </footer>
</div>
{% endblock %}
