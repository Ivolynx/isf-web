{% extends "layouts/portal.njk" %}

{% block title %}Konten Saya — ISF Member Portal{% endblock %}

{% block breadcrumb %}
  <a href="/portal" class="portal-topbar__breadcrumb a">Member Portal</a>
  <span class="portal-topbar__breadcrumb__sep" aria-hidden="true">›</span>
  <span class="portal-topbar__breadcrumb__current">Konten Saya</span>
{% endblock %}

{% block body %}

<div class="portal-page-header">
  <div>
    <h1 class="portal-page-title">Konten Saya</h1>
    <p class="portal-page-lead">Semua pengajuan konten yang Anda kirimkan ke tim ISF.</p>
  </div>
  <a href="/portal/content/new" class="p-btn p-btn--primary p-btn--sm">
    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    Ajukan Konten Baru
  </a>
</div>

{% if dbError %}
<div class="p-alert p-alert--warning" role="alert">{{ dbError }}</div>
{% endif %}

{% if articles and articles.length > 0 %}

{# Status legend #}
<div class="p-section" style="padding:var(--p-sp-4) var(--p-sp-5);margin-bottom:var(--p-sp-5);">
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:var(--p-sp-3);font-size:0.8rem;color:var(--p-text-muted);">
    <div><span class="p-badge p-badge--draft">DRAFT</span> — Belum dikirim.</div>
    <div><span class="p-badge p-badge--in-review">IN REVIEW</span> — Sedang ditinjau.</div>
    <div><span class="p-badge p-badge--changes-requested">CHANGES REQUESTED</span> — Perlu revisi.</div>
    <div><span class="p-badge p-badge--approved">APPROVED</span> — Disetujui.</div>
    <div><span class="p-badge p-badge--published">PUBLISHED</span> — Diterbitkan.</div>
    <div><span class="p-badge p-badge--archived">ARCHIVED</span> — Diarsipkan.</div>
  </div>
</div>

<div class="p-table-wrap">
  <table class="p-table">
    <thead>
      <tr>
        <th>Judul</th>
        <th>Status</th>
        <th>Tanggal Pengajuan</th>
        <th>Catatan Reviewer</th>
        <th>Tindakan</th>
      </tr>
    </thead>
    <tbody>
      {% for article in articles %}
      <tr>
        <td>
          <a href="/portal/content/{{ article.id }}">{{ article.title | truncate(60) }}</a>
        </td>
        <td>
          <span class="p-badge p-badge--{{ article.status | lower | replace('_', '-') }}">
            {{ article.status | replace('_', ' ') }}
          </span>
        </td>
        <td class="p-text-muted p-text-sm">
          {{ article.createdAt | string | truncate(10, true, '') if article.createdAt else '—' }}
        </td>
        <td style="font-size:0.82rem;color:var(--p-text-muted);max-width:18rem;">
          {% if article.reviewerNotes %}
            <span style="color:var(--p-warning-text);">{{ article.reviewerNotes | truncate(80) }}</span>
          {% else %}
            —
          {% endif %}
        </td>
        <td>
          <div style="display:flex;gap:var(--p-sp-2);flex-wrap:wrap;">
            {% if article.status === 'DRAFT' or article.status === 'CHANGES_REQUESTED' %}
              <a href="/portal/content/{{ article.id }}/edit" class="p-btn p-btn--secondary p-btn--sm">Edit</a>
            {% endif %}
            {% if article.status === 'PUBLISHED' %}
              <a href="/blog/{{ article.slug }}" class="p-btn p-btn--primary p-btn--sm" target="_blank" rel="noopener">Lihat Publik</a>
            {% endif %}
            <a href="/portal/content/{{ article.id }}" class="p-btn p-btn--ghost p-btn--sm">Lihat Detail</a>
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% else %}
<div class="p-empty">
  <div class="p-empty__icon" aria-hidden="true">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/>
    </svg>
  </div>
  <h3>Belum ada konten yang diajukan</h3>
  <p>Mulailah berbagi cerita, artikel, atau pengalaman Anda dengan komunitas ISF.</p>
  <a href="/portal/content/new" class="p-btn p-btn--primary" style="margin-top:var(--p-sp-5);">Ajukan Konten Pertama</a>
</div>
{% endif %}

{% endblock %}
