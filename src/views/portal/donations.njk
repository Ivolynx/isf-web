{% extends "layouts/portal.njk" %}

{% block title %}Riwayat Donasi Saya — ISF Member Portal{% endblock %}

{% block breadcrumb %}
  <a href="/portal" class="portal-topbar__breadcrumb a">Member Portal</a>
  <span class="portal-topbar__breadcrumb__sep" aria-hidden="true">›</span>
  <span class="portal-topbar__breadcrumb__current">Donasi Saya</span>
{% endblock %}

{% block body %}

<div class="portal-page-header">
  <div>
    <h1 class="portal-page-title">Donasi Saya</h1>
    <p class="portal-page-lead">Riwayat kontribusi donasi yang telah Anda lakukan.</p>
  </div>
  <a href="/fundraising" class="p-btn p-btn--primary p-btn--sm" target="_blank" rel="noopener">
    Lihat Kampanye Aktif ↗
  </a>
</div>

{% if dbError %}
<div class="p-alert p-alert--warning" role="alert">
  <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" flex-shrink="0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
  <div>{{ dbError }}</div>
</div>
{% elif not donations or donations.length === 0 %}

<div class="p-empty">
  <div class="p-empty__icon" aria-hidden="true">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18-3a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6m18 0v3M3 6v3"/>
    </svg>
  </div>
  <h3>Belum ada donasi</h3>
  <p>Anda belum melakukan donasi. Dukung program ISF dengan berdonasi melalui kampanye aktif.</p>
  <a href="/fundraising" class="p-btn p-btn--primary" style="margin-top:var(--p-sp-5);" target="_blank" rel="noopener">
    Lihat Kampanye Aktif ↗
  </a>
</div>

{% else %}

<div class="p-table-wrap">
  <table class="p-table">
    <thead>
      <tr>
        <th>Kampanye</th>
        <th>Jumlah</th>
        <th>Status</th>
        <th>Metode</th>
        <th>Tanggal</th>
        <th>Referensi</th>
        <th>Bukti</th>
      </tr>
    </thead>
    <tbody>
      {% for don in donations %}
      <tr>
        <td>
          <div style="font-weight:500;">{{ don.campaignTitle | escape | truncate(50) }}</div>
          {% if don.message %}
          <div class="p-text-muted p-text-xs" style="margin-top:0.15rem;">"{{ don.message | escape | truncate(60) }}"</div>
          {% endif %}
        </td>
        <td style="font-weight:600;">{{ don.currency | escape }} {{ don.amount | int }}</td>
        <td>
          <span class="p-badge p-badge--don-{{ don.status | lower }}">
            {% if don.status === 'PAID' %}✓ Dikonfirmasi
            {% elif don.status === 'PENDING' %}Menunggu
            {% elif don.status === 'FAILED' %}Gagal
            {% elif don.status === 'EXPIRED' %}Kedaluwarsa
            {% elif don.status === 'REFUNDED' %}Dikembalikan
            {% else %}{{ don.status }}
            {% endif %}
          </span>
        </td>
        <td class="p-text-muted p-text-sm">{{ don.paymentMethod or '—' }}</td>
        <td class="p-text-muted p-text-sm">{{ don.createdAt }}</td>
        <td class="p-text-muted p-text-xs" style="max-width:9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
          {{ don.externalId or '—' }}
        </td>
        <td>
          {% if don.status === 'PAID' %}
          <a href="/fundraising/donate/receipt/{{ don.id | urlencode }}" class="p-btn p-btn--ghost p-btn--sm">Unduh Bukti</a>
          {% else %}
          <a href="/fundraising/donate/result?donation_id={{ don.id | urlencode }}&status={{ don.status | lower }}" class="p-btn p-btn--ghost p-btn--sm">Detail</a>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endif %}

<style>
/* Donation-specific badge colours — scoped to this page */
.p-badge.p-badge--don-paid     { background:var(--p-success-bg); color:var(--p-success-text); border-color:#b8dfc5; }
.p-badge.p-badge--don-pending  { background:var(--p-warning-bg); color:var(--p-warning-text); border-color:#e8d095; }
.p-badge.p-badge--don-failed   { background:var(--p-error-bg);   color:var(--p-error-text);   border-color:#e8b4b4; }
.p-badge.p-badge--don-expired  { background:#F0F0F0; color:#707070; border-color:#D0D0D0; }
.p-badge.p-badge--don-refunded { background:var(--p-info-bg); color:var(--p-info-text); border-color:#b6d2e3; }
</style>

{% endblock %}
