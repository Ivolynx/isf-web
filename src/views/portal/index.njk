{% extends "layouts/portal.njk" %}

{% block title %}Dashboard — ISF Member Portal{% endblock %}

{% block breadcrumb %}
  <span class="portal-topbar__breadcrumb__current">Dashboard</span>
{% endblock %}

{% block body %}

{# ── Welcome Banner ───────────────────────────────────── #}
<div class="p-welcome-card" role="banner" aria-label="Selamat datang">
  <div class="p-welcome-card__greeting">
    Selamat datang kembali
  </div>
  <h1 class="p-welcome-card__name">{{ displayName or userEmail }}</h1>
  <p class="p-welcome-card__desc">
    Kelola informasi pendidikan, program beasiswa, dan aktivitas ISF Anda melalui dashboard ini.
  </p>
</div>

{# ── Activity Summary Cards ───────────────────────────── #}
<div class="p-stats-grid">

  {# Content submissions #}
  <div class="p-stat-card">
    <div class="p-stat-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/>
      </svg>
    </div>
    <div class="p-stat-card__label">Konten Diajukan</div>
    <div class="p-stat-card__value">{{ recentContent.length if recentContent else 0 }}</div>
    <div class="p-stat-card__sub">
      <a href="/portal/content" style="color:var(--p-accent);font-size:0.78rem;">Lihat semua →</a>
    </div>
  </div>

  {# Donations #}
  <div class="p-stat-card">
    <div class="p-stat-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
      </svg>
    </div>
    <div class="p-stat-card__label">Riwayat Donasi</div>
    <div class="p-stat-card__value">{{ recentDonations.length if recentDonations else 0 }}</div>
    <div class="p-stat-card__sub">
      <a href="/portal/donations" style="color:var(--p-accent);font-size:0.78rem;">Lihat semua →</a>
    </div>
  </div>

  {# Profile card #}
  <div class="p-stat-card">
    <div class="p-stat-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
      </svg>
    </div>
    <div class="p-stat-card__label">Profil</div>
    <div class="p-stat-card__value" style="font-size:1.1rem;">Mahasiswa</div>
    <div class="p-stat-card__sub">
      <a href="/portal/scholarship/profile" style="color:var(--p-accent);font-size:0.78rem;">Lengkapi profil →</a>
    </div>
  </div>

  {# Financing card #}
  <div class="p-stat-card">
    <div class="p-stat-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
      </svg>
    </div>
    <div class="p-stat-card__label">Pembiayaan</div>
    <div class="p-stat-card__value" style="font-size:1.1rem;">Student Loan</div>
    <div class="p-stat-card__sub">
      <a href="/portal/scholarship/loans" style="color:var(--p-accent);font-size:0.78rem;">Lihat detail →</a>
    </div>
  </div>

</div>

{# ── Quick Actions ─────────────────────────────────────── #}
<h2 style="font-family:var(--p-font-serif);font-size:1.1rem;font-weight:500;color:var(--p-text);margin:0 0 var(--p-sp-4);">
  Aksi Cepat
</h2>
<div class="p-actions-grid">

  <a href="/portal/scholarship/profile" class="p-action-card">
    <div class="p-action-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
      </svg>
    </div>
    <div class="p-action-card__title">Lengkapi Profil</div>
    <div class="p-action-card__desc">Data akademik untuk pengajuan beasiswa dan pembiayaan.</div>
  </a>

  <a href="/portal/scholarship/loans" class="p-action-card">
    <div class="p-action-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
      </svg>
    </div>
    <div class="p-action-card__title">Lihat Pembiayaan</div>
    <div class="p-action-card__desc">Pantau status pengajuan beasiswa dan student loan.</div>
  </a>

  <a href="/portal/content/new" class="p-action-card">
    <div class="p-action-card__icon p-action-card__icon--gold" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
      </svg>
    </div>
    <div class="p-action-card__title">Ajukan Konten</div>
    <div class="p-action-card__desc">Kirim artikel, cerita, atau opini ke tim ISF.</div>
  </a>

  <a href="/portal/donations" class="p-action-card">
    <div class="p-action-card__icon" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
      </svg>
    </div>
    <div class="p-action-card__title">Riwayat Donasi</div>
    <div class="p-action-card__desc">Lihat kontribusi dan bukti donasi Anda.</div>
  </a>

  <a href="/fundraising" class="p-action-card" target="_blank" rel="noopener">
    <div class="p-action-card__icon p-action-card__icon--gold" aria-hidden="true">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75"/>
      </svg>
    </div>
    <div class="p-action-card__title">Kampanye Donasi ↗</div>
    <div class="p-action-card__desc">Dukung kampanye fundraising ISF yang sedang aktif.</div>
  </a>

</div>

{# ── Recent Submissions ────────────────────────────────── #}
{% if recentContent and recentContent.length > 0 %}
<div class="p-section p-mt-6">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--p-sp-4);">
    <h2 style="font-family:var(--p-font-serif);font-size:1.05rem;font-weight:500;color:var(--p-text);margin:0;">
      Pengajuan Konten Terbaru
    </h2>
    <a href="/portal/content" class="p-btn p-btn--ghost p-btn--sm">Lihat Semua</a>
  </div>

  <div class="p-table-wrap">
    <table class="p-table">
      <thead>
        <tr>
          <th>Judul</th>
          <th>Status</th>
          <th>Diperbarui</th>
          <th>Tindakan</th>
        </tr>
      </thead>
      <tbody>
        {% for art in recentContent %}
        <tr>
          <td>
            <a href="/portal/content/{{ art.id }}">{{ art.title | truncate(55) }}</a>
          </td>
          <td>
            <span class="p-badge p-badge--{{ art.status | lower | replace('_', '-') }}">
              {{ art.status | replace('_', ' ') }}
            </span>
          </td>
          <td class="p-text-muted p-text-sm">
            {{ art.updatedAt | string | truncate(10, true, '') if art.updatedAt else '—' }}
          </td>
          <td>
            {% if art.status === 'DRAFT' or art.status === 'CHANGES_REQUESTED' %}
              <a href="/portal/content/{{ art.id }}/edit" class="p-btn p-btn--secondary p-btn--sm">Edit</a>
            {% else %}
              <a href="/portal/content/{{ art.id }}" class="p-btn p-btn--ghost p-btn--sm">Lihat Detail</a>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

{% endblock %}
