{% extends "layouts/portal.njk" %}

{% block title %}Ajukan Pembiayaan — ISF Member Portal{% endblock %}

{% block breadcrumb %}
  <a href="/portal" class="portal-topbar__breadcrumb a">Member Portal</a>
  <span class="portal-topbar__breadcrumb__sep" aria-hidden="true">›</span>
  <a href="/portal/scholarship/loans" class="portal-topbar__breadcrumb a">Pembiayaan</a>
  <span class="portal-topbar__breadcrumb__sep" aria-hidden="true">›</span>
  <span class="portal-topbar__breadcrumb__current">Pengajuan Baru</span>
{% endblock %}

{% block body %}

<div class="portal-page-header">
  <div>
    <h1 class="portal-page-title">Ajukan Pembiayaan Mahasiswa</h1>
    <p class="portal-page-lead">Isi detail pengajuan pembiayaan pendidikan. Semua nominal dan tenor final ditetapkan oleh ISF.</p>
  </div>
</div>

<div class="p-alert p-alert--info" role="note">
  <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" flex-shrink="0">
    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
  </svg>
  <div>
    <strong>Mode Simulasi.</strong> Pengajuan ini adalah simulasi. Tidak ada pencairan uang nyata sebelum kebijakan hukum dan operasional disahkan oleh ISF.
  </div>
</div>

{% if error %}
<div class="p-alert p-alert--error" role="alert">{{ error }}</div>
{% endif %}

<form id="loanForm" novalidate>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  {# ── Section: Informasi Akademik ── #}
  <div class="p-section">
    <h2 class="p-section__title">Informasi Akademik</h2>
    <div class="p-form-grid">

      <div class="p-form-group p-full-span">
        <label class="p-label" for="universityName">
          Nama Universitas <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <input type="text" id="universityName" name="universityName" class="p-input"
               required maxlength="300"
               value="{{ profile.universityName if profile else '' }}"
               placeholder="Nama universitas atau perguruan tinggi">
      </div>

      <div class="p-form-group">
        <label class="p-label" for="studyProgram">
          Program Studi <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <input type="text" id="studyProgram" name="studyProgram" class="p-input"
               required maxlength="200"
               value="{{ profile.studyProgram if profile else '' }}"
               placeholder="Nama program studi Anda">
      </div>

      <div class="p-form-group">
        <label class="p-label" for="academicYear">
          Tahun Akademik <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <input type="text" id="academicYear" name="academicYear" class="p-input"
               required maxlength="20"
               placeholder="Contoh: 2024/2025">
      </div>

      <div class="p-form-group">
        <label class="p-label" for="semester">
          Semester yang Dibiayai <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <input type="number" id="semester" name="semester" class="p-input"
               required min="1" max="20"
               value="{{ profile.currentSemester if profile else '' }}"
               placeholder="Contoh: 5">
      </div>

    </div>
  </div>

  {# ── Section: Detail Pembiayaan ── #}
  <div class="p-section">
    <h2 class="p-section__title">Detail Pembiayaan</h2>
    <div class="p-form-grid">

      <div class="p-form-group">
        <label class="p-label" for="requestedAmount">
          Nominal yang Diminta (Rp) <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <input type="number" id="requestedAmount" name="requestedAmount" class="p-input"
               required min="100000" max="100000000000" step="1"
               placeholder="Contoh: 10000000">
        <p class="p-hint">Nominal final ditetapkan oleh ISF setelah penilaian.</p>
      </div>

      <div class="p-form-group">
        <label class="p-label" for="requestedTenorMonths">
          Usulan Tenor (bulan) <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <input type="number" id="requestedTenorMonths" name="requestedTenorMonths" class="p-input"
               required min="1" max="120"
               placeholder="Contoh: 12">
        <p class="p-hint">Tenor final ditetapkan oleh ISF.</p>
      </div>

      <div class="p-form-group p-full-span">
        <label class="p-label" for="purposeDescription">
          Tujuan Penggunaan Dana <span class="req" aria-label="wajib diisi">*</span>
        </label>
        <textarea id="purposeDescription" name="purposeDescription" class="p-textarea"
                  rows="4" required minlength="10" maxlength="2000"
                  placeholder="Jelaskan tujuan dan kebutuhan pembiayaan secara spesifik…"></textarea>
      </div>

    </div>

    {# Estimated costs #}
    <div class="p-mt-4">
      <div class="p-label" style="margin-bottom:var(--p-sp-2);">Estimasi Biaya <span class="p-text-muted" style="font-weight:400;">(opsional)</span></div>
      <div id="costsContainer"></div>
      <button type="button" id="btnAddCost" class="p-btn p-btn--ghost p-btn--sm" style="margin-top:var(--p-sp-2);">
        + Tambah Item Biaya
      </button>
    </div>
  </div>

  {# ── Actions ── #}
  <div style="display:flex;align-items:center;gap:var(--p-sp-3);flex-wrap:wrap;">
    <button type="submit" class="p-btn p-btn--primary" id="btnSubmit">
      <span id="btnSubmitText">Simpan sebagai Draft</span>
      <span class="spinner" id="btnSubmitSpinner" style="display:none;" aria-hidden="true"></span>
    </button>
    <a href="/portal/scholarship/loans" class="p-btn p-btn--ghost">Batal</a>
    <span id="formStatus" style="font-size:0.85rem;color:var(--p-text-muted);" role="status" aria-live="polite"></span>
  </div>
</form>

<script>
(function() {
  'use strict';
  var csrf = '{{ csrfToken }}';
  var costsContainer = document.getElementById('costsContainer');
  var costIndex = 0;

  document.getElementById('btnAddCost').addEventListener('click', function() {
    var div = document.createElement('div');
    div.style.cssText = 'display:flex;gap:var(--p-sp-2,0.5rem);margin-bottom:var(--p-sp-2,0.5rem);align-items:center;';
    div.innerHTML =
      '<input type="text" name="costDesc_' + costIndex + '" class="p-input" style="flex:2;" placeholder="Deskripsi biaya">' +
      '<input type="number" name="costAmount_' + costIndex + '" class="p-input" style="flex:1;" placeholder="Nominal (Rp)" min="0">' +
      '<button type="button" class="p-btn p-btn--ghost p-btn--sm" aria-label="Hapus item" onclick="this.parentElement.remove()">✕</button>';
    costsContainer.appendChild(div);
    costIndex++;
  });

  document.getElementById('loanForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var statusEl = document.getElementById('formStatus');
    var btn      = document.getElementById('btnSubmit');
    var btnTxt   = document.getElementById('btnSubmitText');
    var spinner  = document.getElementById('btnSubmitSpinner');
    statusEl.textContent = 'Menyimpan…';
    btn.disabled = true;
    btnTxt.textContent = 'Menyimpan…';
    spinner.style.display = 'inline-block';

    var body = new FormData(document.getElementById('loanForm'));
    var data = {
      universityName: body.get('universityName'),
      studyProgram:   body.get('studyProgram'),
      academicYear:   body.get('academicYear'),
      semester:       parseInt(body.get('semester')),
      requestedAmount: String(body.get('requestedAmount')),
      requestedTenorMonths: parseInt(body.get('requestedTenorMonths')),
      purposeDescription: body.get('purposeDescription'),
      estimatedCosts: [],
    };
    var i = 0;
    while (body.get('costDesc_' + i) !== null) {
      var desc   = body.get('costDesc_' + i);
      var amount = body.get('costAmount_' + i);
      if (desc && amount) data.estimatedCosts.push({ description: desc, amount: String(amount) });
      i++;
    }

    try {
      var r = await fetch('/api/v1/scholarship/loans', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
        body: JSON.stringify(data),
      });
      var json = await r.json();
      if (!r.ok) {
        var msg = json.details ? json.details.map(function(d) { return d.message; }).join(', ') : (json.error || 'Gagal menyimpan.');
        statusEl.textContent = msg;
        statusEl.style.color = 'var(--p-error-text)';
        btn.disabled = false;
        btnTxt.textContent = 'Simpan sebagai Draft';
        spinner.style.display = 'none';
        return;
      }
      window.location.href = '/portal/scholarship/loans';
    } catch {
      statusEl.textContent = 'Terjadi kesalahan jaringan.';
      statusEl.style.color = 'var(--p-error-text)';
      btn.disabled = false;
      btnTxt.textContent = 'Simpan sebagai Draft';
      spinner.style.display = 'none';
    }
  });
})();
</script>

{% endblock %}
