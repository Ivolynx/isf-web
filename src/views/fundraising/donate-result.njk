{% extends "layouts/base.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="container section" style="padding-top:2.5rem;padding-bottom:4rem;">
  <div style="max-width: 560px; margin: 0 auto; text-align: center;">

    {% if displayStatus === 'PAID' or displayStatus === 'paid' %}
      <div class="result-icon result-icon--success">✓</div>
      <h1>Donasi Diterima!</h1>
      <p>Terima kasih atas donasi Anda. Pembayaran Anda telah berhasil dikonfirmasi.</p>
    {% elif displayStatus === 'PENDING' or displayStatus === 'pending' %}
      <div class="result-icon result-icon--pending">⏳</div>
      <h1>Menunggu Konfirmasi</h1>
      <p>Donasi Anda sedang dalam proses verifikasi pembayaran. Kami akan memperbarui status Anda segera.</p>
      <p style="color: var(--color-text-muted); font-size: 0.85rem;">Status donasi akan diperbarui secara otomatis setelah pembayaran dikonfirmasi oleh gateway.</p>
    {% elif displayStatus === 'FAILED' or displayStatus === 'failed' %}
      <div class="result-icon result-icon--failed">✕</div>
      <h1>Pembayaran Gagal</h1>
      <p>Maaf, pembayaran Anda tidak berhasil diproses. Silakan coba lagi.</p>
    {% elif displayStatus === 'EXPIRED' or displayStatus === 'expired' %}
      <div class="result-icon result-icon--expired">⏰</div>
      <h1>Sesi Pembayaran Kedaluwarsa</h1>
      <p>Tautan pembayaran telah kedaluwarsa. Silakan mulai donasi baru.</p>
    {% else %}
      <div class="result-icon result-icon--pending">?</div>
      <h1>Status Donasi</h1>
      <p>Status donasi Anda sedang diproses.</p>
    {% endif %}

    {% if donation %}
      <div class="donation-summary-box">
        <dl class="donation-summary">
          <div class="donation-summary__row">
            <dt>ID Donasi</dt>
            <dd><code>{{ donation.id | escape }}</code></dd>
          </div>
          <div class="donation-summary__row">
            <dt>Jumlah</dt>
            <dd>Rp {{ donation.amount | int }}</dd>
          </div>
          <div class="donation-summary__row">
            <dt>Status</dt>
            <dd>{{ donation.status | escape }}</dd>
          </div>
        </dl>
        <a href="/fundraising/donate/receipt/{{ donation.id | urlencode }}" class="btn btn--secondary" style="margin-top:1rem;">
          Lihat Bukti Donasi
        </a>
      </div>
    {% endif %}

    <div class="result-actions" style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/fundraising" class="btn btn--primary">Lihat Kampanye Lain</a>
      <a href="/" class="btn btn--secondary">Kembali ke Beranda</a>
    </div>

  </div>
</div>

<style>
.result-icon { font-size: 3rem; margin-bottom: 1rem; }
.result-icon--success { color: var(--color-success-text); }
.result-icon--pending { color: var(--color-accent-display); }
.result-icon--failed  { color: var(--color-error-text); }
.result-icon--expired { color: var(--color-text-muted); }
.donation-summary-box { background: var(--surface-2); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.5rem; margin: 1.5rem 0; text-align: left; }
.donation-summary__row { display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px solid var(--border-subtle); }
.donation-summary__row:last-child { border-bottom: none; }
.donation-summary dt { color: var(--color-text-muted); font-size: 0.875rem; }
.donation-summary dd { font-weight: 600; }
</style>
{% endblock %}
