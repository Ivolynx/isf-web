{% extends "layouts/admin.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block breadcrumb %}
<a href="/admin/fundraising">Kampanye</a>
<span class="admin-breadcrumb__sep">›</span>
<span class="admin-breadcrumb__current">Laporan &amp; Analitik</span>
{% endblock %}

{% block body %}
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Laporan &amp; Analitik Donasi</h1>
    <p class="admin-page-lead">
      Ringkasan keuangan kampanye ISF.
      {% if analytics and analytics.isSimulation %}
        <span class="sim-badge" style="margin-left:0.5rem;">MODE SIMULASI</span>
      {% endif %}
    </p>
  </div>
  <a href="/admin/fundraising/ledger?_csv=1&campaign={{ campaignFilter or '' }}" class="btn btn--ghost btn--sm">
    Export CSV (Buku Kas)
  </a>
</div>

{# ── Filter ──────────────────────────────────────────────────────────────── #}
<form method="GET" action="/admin/fundraising/reports" class="analytics-filter" style="margin-bottom:2rem;">
  <div class="form-row" style="align-items:flex-end;">
    <div class="form-field form-field--grow">
      <label class="form-label" for="filterCampaign">Kampanye</label>
      <select id="filterCampaign" name="campaign" class="form-select">
        <option value="">Semua Kampanye</option>
        {% for c in campaigns %}
          <option value="{{ c.id }}" {{ 'selected' if campaignFilter === c.id else '' }}>{{ c.title }}</option>
        {% endfor %}
      </select>
    </div>
    <div>
      <button type="submit" class="btn btn--secondary btn--sm">Terapkan Filter</button>
    </div>
  </div>
</form>

{% if migrationPending %}
<div class="alert alert--error" style="margin-bottom:1.75rem;">
  <span>⚠</span>
  <span>
    <strong>Database belum dimigrasikan.</strong>
    Tabel fundraising belum tersedia. Jalankan <code>npm run db:migrate</code> untuk membuatnya.
  </span>
</div>
{% endif %}

{% if analytics and not migrationPending %}
{# ── Simulation notice ─────────────────────────────────────────────────── #}
{% if analytics.isSimulation %}
<div class="alert alert--warning" style="margin-bottom:1.75rem;">
  <span>⚠</span>
  <span>
    <strong>Data di bawah berasal dari transaksi SIMULASI (mock gateway).</strong>
    Angka ini bukan representasi uang sungguhan. Jangan gunakan sebagai laporan keuangan nyata.
  </span>
</div>
{% endif %}

{# ── KPI Stats ─────────────────────────────────────────────────────────── #}
<div class="stats-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:1rem;margin-bottom:2rem;">

  <div class="stat-card stat-card--positive">
    <p class="stat-card__label">Total Donasi Berhasil</p>
    <p class="stat-card__value">Rp {{ analytics.totalPaid | int }}</p>
    <p class="stat-card__sub">{{ analytics.countPaid }} transaksi PAID</p>
  </div>

  <div class="stat-card">
    <p class="stat-card__label">Dana Bersih Tersedia</p>
    <p class="stat-card__value" style="color:var(--color-accent-display);">Rp {{ analytics.netAvailable | int }}</p>
    <p class="stat-card__sub">Setelah refund (Rp {{ analytics.totalRefunded | int }})</p>
  </div>

  <div class="stat-card">
    <p class="stat-card__label">Jumlah Donatur</p>
    <p class="stat-card__value">{{ analytics.uniqueDonors }}</p>
    <p class="stat-card__sub">Donatur unik (login + anonim)</p>
  </div>

  <div class="stat-card">
    <p class="stat-card__label">Rata-rata Donasi</p>
    <p class="stat-card__value">Rp {{ analytics.avgDonation | int }}</p>
    <p class="stat-card__sub">Per transaksi berhasil</p>
  </div>

  <div class="stat-card stat-card--pending">
    <p class="stat-card__label">Donasi Pending</p>
    <p class="stat-card__value">Rp {{ analytics.totalPending | int }}</p>
    <p class="stat-card__sub">{{ analytics.countPending }} transaksi — belum dikonfirmasi</p>
  </div>

  <div class="stat-card stat-card--negative">
    <p class="stat-card__label">Donasi Gagal / Expired</p>
    <p class="stat-card__value">Rp {{ analytics.totalFailed | int }}</p>
    <p class="stat-card__sub">{{ analytics.countFailed }} transaksi — tidak dihitung</p>
  </div>

  <div class="stat-card">
    <p class="stat-card__label">Refund</p>
    <p class="stat-card__value">Rp {{ analytics.totalRefunded | int }}</p>
    <p class="stat-card__sub">{{ analytics.countRefunded }} transaksi dikembalikan</p>
  </div>
</div>

{# ── Transparency notes ────────────────────────────────────────────────── #}
<div class="owner-section" style="margin-bottom:2rem;">
  <h2 class="owner-section__title">Catatan Transparansi &amp; Metodologi</h2>
  <ul style="padding-left:1.5rem;line-height:2;font-size:0.875rem;color:var(--color-text-muted);">
    <li>Total dana <strong style="color:var(--color-text);">hanya mencakup donasi PAID</strong> yang dikonfirmasi oleh webhook payment gateway.</li>
    <li>Donasi PENDING <strong style="color:var(--color-text);">tidak dihitung</strong> sebagai uang yang diterima.</li>
    <li>Dana bersih = Total PAID − Total REFUNDED.</li>
    <li>Donasi FAILED atau EXPIRED <strong style="color:var(--color-text);">tidak masuk hitungan kas</strong>.</li>
    <li>Seluruh perubahan status dicatat dalam audit log sistem.</li>
    {% if analytics.isSimulation %}
    <li style="color:var(--color-warning-text);"><strong>Semua transaksi saat ini menggunakan mock gateway (SIMULASI). Data ini bukan uang sungguhan.</strong></li>
    {% endif %}
    <li>Periode: {{ analytics.periodLabel }}</li>
  </ul>
</div>
{% endif %}

{# ── Campaign table ────────────────────────────────────────────────────── #}
{% if campaigns and campaigns.length > 0 %}
<div class="owner-section" style="padding:0;">
  <h2 class="owner-section__title" style="padding:1.5rem 1.75rem 0;">Rekap per Kampanye</h2>
  <div class="table-wrapper" style="border:0;border-radius:0 0 var(--radius-md) var(--radius-md);">
    <table class="data-table">
      <thead>
        <tr>
          <th>Kampanye</th>
          <th>Status</th>
          <th style="text-align:right;">Target</th>
          <th style="text-align:right;">Terkumpul (PAID)</th>
          <th style="text-align:right;">Donatur</th>
          <th style="text-align:right;">%</th>
        </tr>
      </thead>
      <tbody>
        {% for campaign in campaigns %}
        {% set goalAmount = campaign.goalAmount | float %}
        {% set totalRaised = campaign.totalRaised | float %}
        {% set pct = (totalRaised / goalAmount * 100) | round if goalAmount > 0 else 0 %}
        <tr>
          <td>
            <a href="/admin/fundraising/{{ campaign.id | urlencode }}" style="font-weight:500;color:var(--color-text);">
              {{ campaign.title | escape }}
            </a>
          </td>
          <td>
            <span class="status-badge status-badge--{{ campaign.status | lower }}">{{ campaign.status }}</span>
          </td>
          <td style="text-align:right;">Rp {{ campaign.goalAmount | int }}</td>
          <td style="text-align:right;font-weight:600;color:var(--color-accent-display);">Rp {{ campaign.totalRaised | int }}</td>
          <td style="text-align:right;">{{ campaign.donationCount }}</td>
          <td style="text-align:right;">{{ pct }}%</td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr style="border-top:2px solid var(--color-border-strong);">
          <td colspan="3" style="padding:0.875rem 1rem;font-weight:600;color:var(--color-text);">Total semua kampanye</td>
          <td style="padding:0.875rem 1rem;text-align:right;font-weight:700;color:var(--color-accent-display);">
            Rp {{ campaigns | sum(attribute='totalRaised') | int }}
          </td>
          <td style="padding:0.875rem 1rem;text-align:right;font-weight:600;">
            {{ campaigns | sum(attribute='donationCount') }}
          </td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
{% else %}
<div class="empty-state">
  <p>Belum ada kampanye yang memiliki data donasi.</p>
</div>
{% endif %}
{% endblock %}
