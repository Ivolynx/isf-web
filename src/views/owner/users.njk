{% extends "layouts/admin.njk" %}

{% block title %}User Management — ISF{% endblock %}

{% block breadcrumb %}
<a href="/owner">Owner Dashboard</a>
<span class="admin-breadcrumb__sep">›</span>
<span class="admin-breadcrumb__current">User Management</span>
{% endblock %}

{% block body %}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
      <div>
        <h1 class="portal-main__heading" style="margin-bottom:0.25rem;">Users</h1>
        <p style="color:var(--color-text-muted);font-size:0.9rem;margin:0;">{{ total }} account{{ 's' if total != 1 }}</p>
      </div>
      <a class="btn btn--primary btn--sm" href="/owner/invitations">Invite user</a>
    </div>

    <form method="GET" action="/owner/users" style="margin-bottom:1.5rem;display:flex;gap:0.75rem;">
      <input
        class="form-input"
        type="search"
        name="q"
        value="{{ search }}"
        placeholder="Search by email or name…"
        autocomplete="off"
        style="max-width:24rem;"
      >
      <button class="btn btn--ghost btn--sm" type="submit">Search</button>
      {% if search %}
      <a class="btn btn--ghost btn--sm" href="/owner/users">Clear</a>
      {% endif %}
    </form>

    <div class="data-table-wrap">
      <table class="data-table" style="width:100%;font-size:0.85rem;">
        <thead>
          <tr>
            <th style="text-align:left;padding:0.5rem 0.75rem;">Email</th>
            <th style="text-align:left;padding:0.5rem 0.75rem;">Name</th>
            <th style="text-align:left;padding:0.5rem 0.75rem;">Role</th>
            <th style="text-align:left;padding:0.5rem 0.75rem;">Status</th>
            <th style="text-align:left;padding:0.5rem 0.75rem;">Verified</th>
            <th style="text-align:left;padding:0.5rem 0.75rem;"></th>
          </tr>
        </thead>
        <tbody>
          {% for u in users %}
          <tr>
            <td style="padding:0.65rem 0.75rem;">{{ u.email }}</td>
            <td style="padding:0.65rem 0.75rem;color:var(--color-text-secondary);">{{ u.displayName or '—' }}</td>
            <td style="padding:0.65rem 0.75rem;">
              <span class="role-badge role-badge--{{ u.role | lower }}">{{ u.role }}</span>
            </td>
            <td style="padding:0.65rem 0.75rem;">
              {% if u.isActive %}
              <span style="color:var(--color-success-text);font-size:0.8rem;font-weight:600;">● Active</span>
              {% else %}
              <span style="color:var(--color-error-text);font-size:0.8rem;font-weight:600;">● Disabled</span>
              {% endif %}
            </td>
            <td style="padding:0.65rem 0.75rem;color:var(--color-text-muted);font-size:0.8rem;">
              {% if u.emailVerifiedAt %}✓ Verified{% else %}Pending{% endif %}
            </td>
            <td style="padding:0.65rem 0.75rem;">
              <a href="/owner/users/{{ u.id }}" class="btn btn--ghost btn--sm" style="padding:0.35rem 0.75rem;font-size:0.78rem;">View</a>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="6" style="padding:2rem;text-align:center;color:var(--color-text-muted);">
              {% if search %}No users found matching "{{ search }}".{% else %}No users yet.{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
    <div style="display:flex;gap:0.5rem;justify-content:center;margin-top:1.5rem;">
      {% if page > 1 %}
      <a class="btn btn--ghost btn--sm" href="/owner/users?q={{ search }}&page={{ page - 1 }}">Previous</a>
      {% endif %}
      <span style="padding:0.55rem 1rem;color:var(--color-text-muted);font-size:0.85rem;">{{ page }} / {{ totalPages }}</span>
      {% if page < totalPages %}
      <a class="btn btn--ghost btn--sm" href="/owner/users?q={{ search }}&page={{ page + 1 }}">Next</a>
      {% endif %}
    </div>
    {% endif %}
{% endblock %}
