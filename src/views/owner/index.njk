{% extends "layouts/admin.njk" %}

{% block title %}Owner Dashboard — ISF{% endblock %}

{% block breadcrumb %}
<span class="admin-breadcrumb__current">Owner Dashboard</span>
{% endblock %}

{% block body %}
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Owner Dashboard</h1>
    <p class="admin-page-lead">Governance dan administrasi sistem Intelligentsia Scholarship Fund. Selamat datang, {{ displayName or userEmail }}.</p>
  </div>
</div>

{# Stats row #}
<div class="admin-stats-row">
  <div class="admin-stat-card">
    <div class="admin-stat-card__label">Total Pengguna</div>
    <div class="admin-stat-card__value">{{ userCount or '—' }}</div>
    <div class="admin-stat-card__sub">Semua role terdaftar</div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-card__label">Role</div>
    <div class="admin-stat-card__value" style="font-size:1rem;padding-top:0.3rem;">OWNER</div>
    <div class="admin-stat-card__sub">Hak akses penuh</div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-card__label">Akun</div>
    <div class="admin-stat-card__value" style="font-size:0.82rem;padding-top:0.25rem;word-break:break-all;">{{ userEmail }}</div>
  </div>
</div>

<h2 style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted,#5C6E74);margin-bottom:0.85rem;">Manajemen Sistem</h2>
<div class="admin-quick-grid">

  <a href="/owner/users" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z"/></svg>
    </div>
    <div class="admin-quick-card__title">User Management</div>
    <div class="admin-quick-card__desc">Daftar pengguna, undang anggota baru, kelola role dan status akun.</div>
  </a>

  <a href="/owner/invitations" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
    </div>
    <div class="admin-quick-card__title">Undangan</div>
    <div class="admin-quick-card__desc">Undang editor, reviewer, atau admin baru ke platform ISF.</div>
  </a>

</div>

<h2 style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted,#5C6E74);margin:1.5rem 0 0.85rem;">Konten & Kampanye</h2>
<div class="admin-quick-grid">

  <a href="/admin/cms" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg>
    </div>
    <div class="admin-quick-card__title">CMS & Blog</div>
    <div class="admin-quick-card__desc">Kelola artikel, kategori, tag, dan review konten editorial.</div>
  </a>

  <a href="/admin/cms/review" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="admin-quick-card__title">Review Artikel</div>
    <div class="admin-quick-card__desc">Tinjau artikel yang menunggu persetujuan dari editor.</div>
  </a>

  <a href="/admin/fundraising" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
    </div>
    <div class="admin-quick-card__title">Kampanye Fundraising</div>
    <div class="admin-quick-card__desc">Kelola kampanye fundraising dan pantau progres donasi.</div>
  </a>

  <a href="/admin/fundraising/reports" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z"/></svg>
    </div>
    <div class="admin-quick-card__title">Laporan Donasi</div>
    <div class="admin-quick-card__desc">Laporan detail transaksi donasi dan ringkasan keuangan kampanye.</div>
  </a>

</div>

<h2 style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted,#5C6E74);margin:1.5rem 0 0.85rem;">Beasiswa & Pembiayaan</h2>
<div class="admin-quick-grid">

  <a href="/admin/scholarship" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342"/></svg>
    </div>
    <div class="admin-quick-card__title">Dashboard Beasiswa</div>
    <div class="admin-quick-card__desc">Pantau dan kelola program beasiswa dan pembiayaan ISF.</div>
  </a>

  <a href="/admin/scholarship/profiles" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="admin-quick-card__title">Verifikasi Profil</div>
    <div class="admin-quick-card__desc">Verifikasi profil mahasiswa yang mengajukan beasiswa.</div>
  </a>

  <a href="/admin/scholarship/loans" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
    </div>
    <div class="admin-quick-card__title">Pengajuan Pembiayaan</div>
    <div class="admin-quick-card__desc">Lihat dan setujui pengajuan pembiayaan student loan.</div>
  </a>

  <a href="/admin/scholarship/ledger" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
    </div>
    <div class="admin-quick-card__title">Buku Pembiayaan</div>
    <div class="admin-quick-card__desc">Ledger lengkap semua transaksi pembiayaan mahasiswa.</div>
  </a>

  <a href="/portal" class="admin-quick-card">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
    </div>
    <div class="admin-quick-card__title">Member Portal</div>
    <div class="admin-quick-card__desc">Lihat portal anggota dari perspektif mahasiswa.</div>
  </a>

  <div class="admin-quick-card admin-quick-card--disabled">
    <div class="admin-quick-card__icon">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/></svg>
    </div>
    <div class="admin-quick-card__title">Audit Log</div>
    <div class="admin-quick-card__desc">Belum tersedia. Riwayat aktivitas sistem akan ditampilkan di sini.</div>
  </div>

</div>
{% endblock %}
