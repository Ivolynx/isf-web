{#
  portal-sidebar.njk — Navigation for authenticated Member Portal (USER role).
  Variables from route:
    currentPath — current URL path
    hasActiveLoans — boolean, whether user has any student loan / installments
#}

{# ── GROUP 1: Dashboard & Account ── #}
<div class="portal-sidebar__section-label">Akun Saya</div>

<a href="/portal"
   class="portal-sidebar__item{{ ' is-active' if currentPath == '/portal' else '' }}"
   data-tooltip="Dashboard"
   aria-current="{{ 'page' if currentPath == '/portal' else 'false' }}">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Dashboard</span>
</a>

<a href="/portal/scholarship/profile"
   class="portal-sidebar__item{{ ' is-active' if currentPath == '/portal/scholarship/profile' else '' }}"
   data-tooltip="Profil Mahasiswa">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Profil Mahasiswa</span>
</a>

{# ── GROUP 2: Beasiswa & Pembiayaan ── #}
<div class="portal-sidebar__divider"></div>
<div class="portal-sidebar__section-label">Beasiswa</div>

<a href="/portal/scholarship/loans"
   class="portal-sidebar__item{{ ' is-active' if currentPath == '/portal/scholarship/loans' or currentPath.indexOf('/portal/scholarship/loan') === 0 else '' }}"
   data-tooltip="Pembiayaan Saya">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Pembiayaan Saya</span>
</a>

{% if hasActiveLoans %}
<a href="/portal/scholarship/loans"
   class="portal-sidebar__item{{ ' is-active' if currentPath.indexOf('/portal/scholarship/installment') === 0 else '' }}"
   data-tooltip="Tagihan &amp; Cicilan">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Tagihan &amp; Cicilan</span>
</a>
{% endif %}

{# ── GROUP 3: Konten & Donasi ── #}
<div class="portal-sidebar__divider"></div>
<div class="portal-sidebar__section-label">Aktivitas</div>

<a href="/portal/content"
   class="portal-sidebar__item{{ ' is-active' if currentPath == '/portal/content' or (currentPath.indexOf('/portal/content') === 0 and currentPath != '/portal/content/new') else '' }}"
   data-tooltip="Konten Saya">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Konten Saya</span>
</a>

<a href="/portal/content/new"
   class="portal-sidebar__item{{ ' is-active' if currentPath == '/portal/content/new' else '' }}"
   data-tooltip="Ajukan Konten">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Ajukan Konten</span>
</a>

<a href="/portal/donations"
   class="portal-sidebar__item{{ ' is-active' if currentPath == '/portal/donations' else '' }}"
   data-tooltip="Donasi Saya">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Donasi Saya</span>
</a>

{# ── GROUP 4: Discover ── #}
<div class="portal-sidebar__divider"></div>
<div class="portal-sidebar__section-label">Jelajahi</div>

<a href="/fundraising"
   class="portal-sidebar__item"
   data-tooltip="Kontribusi"
   target="_blank"
   rel="noopener">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Kontribusi ↗</span>
</a>

<a href="/blog"
   class="portal-sidebar__item"
   data-tooltip="Blog ISF"
   target="_blank"
   rel="noopener">
  <span class="portal-sidebar__item-icon" aria-hidden="true">
    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
    </svg>
  </span>
  <span class="portal-sidebar__item-label">Blog ISF ↗</span>
</a>
