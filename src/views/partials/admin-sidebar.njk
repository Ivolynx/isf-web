{#
  admin-sidebar.njk — Shared persistent sidebar for all authenticated admin pages.
  Variables expected from route:
    userRole    — current user's role (OWNER/ADMIN/EDITOR/REVIEWER/USER)
    currentPath — current URL path (set by page middleware or inline)
#}

{# Helper macro for a sidebar link #}

{# ────────────────────────────────────────────────
   GROUP 1 — Dashboard
   ──────────────────────────────────────────────── #}
<div class="sidebar-group">
  <div class="sidebar-group__label">Dashboard</div>

  {% if userRole == 'OWNER' %}
  <a href="/owner"
     class="sidebar-item{{ ' is-active' if currentPath == '/owner' else '' }}"
     data-tooltip="Owner Dashboard">
    <span class="sidebar-item__icon">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
    </span>
    <span class="sidebar-item__label">Owner Dashboard</span>
  </a>
  {% endif %}

  <a href="/admin"
     class="sidebar-item{{ ' is-active' if currentPath == '/admin' else '' }}"
     data-tooltip="Admin Overview">
    <span class="sidebar-item__icon">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
    </span>
    <span class="sidebar-item__label">Admin Overview</span>
  </a>

  <a href="/portal"
     class="sidebar-item{{ ' is-active' if currentPath == '/portal' else '' }}"
     data-tooltip="Member Portal">
    <span class="sidebar-item__icon">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
    </span>
    <span class="sidebar-item__label">Member Portal</span>
  </a>
</div>

{# ────────────────────────────────────────────────
   GROUP 2 — User & Access (OWNER only)
   ──────────────────────────────────────────────── #}
{% if userRole == 'OWNER' %}
<div class="sidebar-divider"></div>
<div class="sidebar-group">
  <div class="sidebar-group__label">User & Access</div>

  <a href="/owner/users"
     class="sidebar-item{{ ' is-active' if currentPath == '/owner/users' or currentPath.indexOf('/owner/users/') === 0 else '' }}"
     data-tooltip="User Management">
    <span class="sidebar-item__icon">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z"/></svg>
    </span>
    <span class="sidebar-item__label">User Management</span>
  </a>

  <a href="/owner/invitations"
     class="sidebar-item{{ ' is-active' if currentPath == '/owner/invitations' or currentPath.indexOf('/owner/invitations/') === 0 else '' }}"
     data-tooltip="Invitations">
    <span class="sidebar-item__icon">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
    </span>
    <span class="sidebar-item__label">Invitations</span>
  </a>
</div>
{% endif %}

