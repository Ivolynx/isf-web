{% extends "layouts/admin.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block breadcrumb %}
<a href="/admin">Admin</a>
<span class="admin-breadcrumb__sep">›</span>
<span class="admin-breadcrumb__current">CMS Dashboard</span>
{% endblock %}

{% block body %}
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">CMS Dashboard</h1>
    <p class="admin-page-lead">Kelola artikel, kategori, dan tag platform ISF.</p>
  </div>
  {% if isEditor %}
  <a href="/admin/cms/articles/new" class="btn btn--primary btn--sm" style="text-decoration:none;">
    + Artikel Baru
  </a>
  {% endif %}
</div>

{% if articles and articles.length > 0 %}
<div class="data-table-wrap" style="margin-bottom:2rem;">
  <table class="data-table">
    <thead>
      <tr>
        <th>Judul</th>
        <th>Status</th>
        <th>Penulis</th>
        <th>Diperbarui</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      {% for article in articles %}
      <tr>
        <td>
          <a href="/admin/cms/articles/{{ article.id }}" style="color:var(--color-text);font-weight:500;text-decoration:none;">
            {{ article.title }}
          </a>
        </td>
        <td>
          <span class="status-badge status-badge--{{ article.status | lower | replace('_', '-') }}">
            {% if article.status == 'DRAFT' %}Draft
            {% elif article.status == 'IN_REVIEW' %}Menunggu Review
            {% elif article.status == 'CHANGES_REQUESTED' %}Perlu Perbaikan
            {% elif article.status == 'APPROVED' %}Disetujui
            {% elif article.status == 'PUBLISHED' %}Diterbitkan
            {% elif article.status == 'ARCHIVED' %}Diarsipkan
            {% else %}{{ article.status }}{% endif %}
          </span>
        </td>
        <td style="color:var(--color-text-muted);font-size:0.82rem;">
          {{ article.authorName or article.authorId | truncate(20) }}
        </td>
        <td style="color:var(--color-text-muted);font-size:0.85rem;">
          {{ article.updatedAt | string | truncate(10, true, '') if article.updatedAt else '-' }}
        </td>
        <td>
          <div class="data-table__actions">
            <a href="/admin/cms/articles/{{ article.id }}" class="btn btn--ghost btn--sm">Lihat</a>
            {% if isEditor or isAdmin %}
            <a href="/admin/cms/articles/{{ article.id }}/edit" class="btn btn--ghost btn--sm">Edit</a>
            {% endif %}
            {% if article.status == 'PUBLISHED' %}
            <a href="/blog/{{ article.slug }}" target="_blank" class="btn btn--ghost btn--sm" style="color:var(--color-success-text);">Blog ↗</a>
            {% endif %}
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<div class="admin-empty">
  <div class="admin-empty__icon" aria-hidden="true">
    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg>
  </div>
  <h3>Belum ada artikel</h3>
  <p>Mulai dengan membuat artikel pertama Anda.</p>
  {% if isEditor %}
  <a href="/admin/cms/articles/new" class="btn btn--primary" style="margin-top:1rem;display:inline-flex;">Buat Artikel Pertama</a>
  {% endif %}
</div>
{% endif %}
{% endblock %}
