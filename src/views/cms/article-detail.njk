{% extends "layouts/admin.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block breadcrumb %}
<a href="/admin">Admin</a>
<span class="admin-breadcrumb__sep">›</span>
<a href="/admin/cms">CMS</a>
<span class="admin-breadcrumb__sep">›</span>
<span class="admin-breadcrumb__current">{{ article.title | truncate(40) }}</span>
{% endblock %}

{% block body %}
<div>
    <!-- Article header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">{{ article.title }}</h1>
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;font-size:0.85rem;color:var(--color-text-muted);margin-top:0.5rem;">
          <span class="status-badge status-badge--{{ article.status | lower | replace('_', '-') }}">
            {% if article.status == 'DRAFT' %}Draft
            {% elif article.status == 'IN_REVIEW' %}Menunggu Review
            {% elif article.status == 'CHANGES_REQUESTED' %}Perlu Perbaikan
            {% elif article.status == 'APPROVED' %}Disetujui
            {% elif article.status == 'PUBLISHED' %}Diterbitkan
            {% elif article.status == 'ARCHIVED' %}Diarsipkan
            {% else %}{{ article.status }}{% endif %}
          </span>
          <span>Dibuat: {{ article.createdAt | string | truncate(10, true, '') if article.createdAt else '-' }}</span>
          <span>Diperbarui: {{ article.updatedAt | string | truncate(10, true, '') if article.updatedAt else '-' }}</span>
          {% if article.publishedAt %}
          <span>Diterbitkan: {{ article.publishedAt | string | truncate(10, true, '') }}</span>
          {% endif %}
        </div>
      </div>

      <!-- Actions -->
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        {% if canEdit %}
        <a href="/admin/cms/articles/{{ article.id }}/edit" class="btn btn--ghost btn--sm">Edit</a>
        {% endif %}
        {% if article.status == 'PUBLISHED' %}
        <a href="/blog/{{ article.slug }}" target="_blank" class="btn btn--primary btn--sm">Lihat di Blog ↗</a>
        {% endif %}
      </div>
    </div>

    <!-- Workflow step indicator -->
    <div class="workflow-steps">
      <span class="workflow-step {{ 'workflow-step--done' if article.status != 'DRAFT' else 'workflow-step--current' }}">Draft</span>
      <span class="workflow-arrow">›</span>
      <span class="workflow-step {{ 'workflow-step--done' if article.status in ['APPROVED', 'PUBLISHED', 'ARCHIVED'] else ('workflow-step--current' if article.status == 'IN_REVIEW' or article.status == 'CHANGES_REQUESTED' else '') }}">Review</span>
      <span class="workflow-arrow">›</span>
      <span class="workflow-step {{ 'workflow-step--done' if article.status in ['PUBLISHED', 'ARCHIVED'] else ('workflow-step--current' if article.status == 'APPROVED' else '') }}">Disetujui</span>
      <span class="workflow-arrow">›</span>
      <span class="workflow-step {{ 'workflow-step--current' if article.status == 'PUBLISHED' else '' }}">Diterbitkan</span>
    </div>

    <!-- Self-approval notice -->
    {% if canReview and isOwnArticle and article.status == 'IN_REVIEW' %}
    <div class="alert alert--warn" style="margin-bottom:1.5rem;">
      <strong>Perhatian:</strong> Anda tidak dapat menyetujui artikel Anda sendiri. Artikel ini perlu ditinjau oleh reviewer lain.
    </div>
    {% endif %}

    <!-- Reviewer notes alert -->
    {% if article.reviewerNotes %}
    <div class="alert alert--error" style="margin-bottom:1.5rem;">
      <strong>Catatan Reviewer:</strong> {{ article.reviewerNotes }}
    </div>
    {% endif %}

    <!-- Article metadata -->
    <div class="info-grid" style="margin-bottom:2rem;">
      <div class="info-card">
        <p class="info-card__label">Penulis</p>
        <p class="info-card__value">{{ article.authorId }}</p>
      </div>
      {% if article.categories and article.categories.length > 0 %}
      <div class="info-card">
        <p class="info-card__label">Kategori</p>
        <p class="info-card__value">
          {% for cat in article.categories %}<span style="background:var(--color-info-bg);color:var(--color-info-text);padding:0.1rem 0.5rem;border-radius:999px;font-size:0.78rem;margin-right:0.25rem;">{{ cat.name }}</span>{% endfor %}
        </p>
      </div>
      {% endif %}
      {% if article.tags and article.tags.length > 0 %}
      <div class="info-card">
        <p class="info-card__label">Tag</p>
        <p class="info-card__value">
          {% for tag in article.tags %}<span style="background:var(--color-accent-light);color:var(--color-accent);padding:0.1rem 0.5rem;border-radius:999px;font-size:0.78rem;margin-right:0.25rem;">{{ tag.name }}</span>{% endfor %}
        </p>
      </div>
      {% endif %}
    </div>

    <!-- Article content preview -->
    <div class="info-card" style="padding:1.5rem;margin-bottom:2rem;">
      <h2 style="font-size:0.78rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">Konten Artikel</h2>
      {% if article.summary %}
      <p style="color:var(--color-text-muted);font-style:italic;margin-bottom:1.5rem;font-size:0.95rem;">{{ article.summary }}</p>
      {% endif %}
      <div class="article-body-preview" style="max-height:400px;overflow-y:auto;border-top:1px solid rgba(255,255,255,0.06);padding-top:1rem;">
        {{ article.bodyHtml | safe }}
      </div>
    </div>

    <!-- Review actions (REVIEWER / ADMIN / OWNER) -->
    {% if canReview and article.status == 'IN_REVIEW' and not isOwnArticle %}
    <div class="info-card" style="padding:1.5rem;margin-bottom:2rem;">
      <h2 style="font-size:0.78rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">Tindakan Review</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <button type="button" id="btn-approve" class="btn btn--primary" style="background:var(--color-success-text);">✓ Setujui</button>
        <button type="button" id="btn-request-changes" class="btn btn--ghost" style="color:var(--color-error-text);border-color:var(--color-error-border);">✗ Minta Revisi</button>
      </div>
      <div id="review-form" style="display:none;margin-top:1rem;">
        <label class="form-label" for="review-notes">Catatan untuk Penulis <span style="color:var(--color-error-text)">*</span></label>
        <textarea id="review-notes" class="form-input" rows="3" placeholder="Jelaskan perubahan yang diperlukan..." maxlength="1000"></textarea>
        <div style="display:flex;gap:0.75rem;margin-top:0.75rem;">
          <button type="button" id="btn-confirm-changes" class="btn btn--primary" style="background:rgba(192,57,43,0.8);">Kirim Permintaan Revisi</button>
          <button type="button" id="btn-cancel-review" class="btn btn--ghost">Batal</button>
        </div>
      </div>
      <div id="review-error" class="alert alert--error" style="display:none;margin-top:0.75rem;"></div>
    </div>
    {% endif %}

    <!-- Publish action (ADMIN / OWNER) -->
    {% if canPublish and article.status == 'APPROVED' %}
    <div class="info-card" style="padding:1.5rem;margin-bottom:2rem;">
      <h2 style="font-size:0.78rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">Terbitkan Artikel</h2>
      <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1rem;">Artikel ini telah disetujui. Anda dapat menerbitkannya ke blog publik.</p>
      <button type="button" id="btn-publish" class="btn btn--primary">Terbitkan Sekarang</button>
      <div id="publish-error" class="alert alert--error" style="display:none;margin-top:0.75rem;"></div>
    </div>
    {% endif %}

    <!-- Archive / unpublish (ADMIN / OWNER) -->
    {% if canPublish and article.status == 'PUBLISHED' %}
    <div class="info-card" style="padding:1.5rem;margin-bottom:2rem;">
      <h2 style="font-size:0.78rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">Kelola Publikasi</h2>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
        <button type="button" id="btn-archive" class="btn btn--ghost">Arsipkan</button>
        <button type="button" id="btn-unpublish" class="btn btn--ghost" style="color:var(--color-warning-text);">Cabut Publikasi</button>
      </div>
      <div id="manage-error" class="alert alert--error" style="display:none;margin-top:0.75rem;"></div>
    </div>
    {% endif %}

    <!-- Revision history -->
    {% if article.revisions and article.revisions.length > 0 %}
    <div class="info-card" style="padding:1.5rem;">
      <h2 style="font-size:0.78rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">Riwayat Revisi</h2>
      <div style="display:flex;flex-direction:column;gap:0.5rem;">
        {% for rev in article.revisions %}
        <div style="padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;">
          <span style="color:var(--color-text-muted);">{{ rev.createdAt | date('DD MMM YYYY HH:mm') if rev.createdAt else '-' }}</span>
          {% if rev.revisionNote %}
          <span style="color:var(--color-text-secondary);margin-left:0.75rem;">— {{ rev.revisionNote }}</span>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
</div>

<style>
.article-body-preview h1,.article-body-preview h2,.article-body-preview h3 { font-family:var(--font-display); margin:1rem 0 0.5rem; }
.article-body-preview p { margin:0 0 0.75rem; color:var(--color-text-secondary); }
.article-body-preview ul,.article-body-preview ol { padding-left:1.5rem; margin-bottom:0.75rem; }
.article-body-preview blockquote { border-left:4px solid var(--color-accent); padding:0.5rem 1rem; background:var(--color-accent-light); border-radius:0 4px 4px 0; }
.article-body-preview code { background:var(--color-bg-secondary); padding:0.15em 0.4em; border-radius:3px; font-size:0.88em; }
.article-body-preview pre { background:var(--color-bg-secondary); padding:0.75rem; border-radius:6px; overflow-x:auto; }
.article-body-preview a { color:var(--color-accent); }
</style>

<script>
(function() {
  const CSRF = '{{ csrfToken }}';
  const ARTICLE_ID = '{{ article.id }}';

  async function doAction(path, body) {
    const resp = await fetch('/api/v1/articles/' + ARTICLE_ID + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify(body || {}),
    });
    const result = await resp.json();
    if (!resp.ok) throw new Error(result.error || 'Terjadi kesalahan.');
    return result;
  }

  function showError(id, msg) {
    const el = document.getElementById(id);
    if (el) { el.textContent = msg; el.style.display = 'block'; }
  }

  // Approve
  const btnApprove = document.getElementById('btn-approve');
  if (btnApprove) {
    btnApprove.addEventListener('click', async function() {
      try {
        await doAction('/approve', {});
        window.location.reload();
      } catch(e) { showError('review-error', e.message); }
    });
  }

  // Request changes
  const btnRequestChanges = document.getElementById('btn-request-changes');
  if (btnRequestChanges) {
    btnRequestChanges.addEventListener('click', function() {
      document.getElementById('review-form').style.display = 'block';
    });
  }

  const btnConfirmChanges = document.getElementById('btn-confirm-changes');
  if (btnConfirmChanges) {
    btnConfirmChanges.addEventListener('click', async function() {
      const notes = document.getElementById('review-notes').value.trim();
      if (!notes) { showError('review-error', 'Catatan wajib diisi.'); return; }
      try {
        await doAction('/request-changes', { notes });
        window.location.reload();
      } catch(e) { showError('review-error', e.message); }
    });
  }

  const btnCancelReview = document.getElementById('btn-cancel-review');
  if (btnCancelReview) {
    btnCancelReview.addEventListener('click', function() {
      document.getElementById('review-form').style.display = 'none';
    });
  }

  // Publish
  const btnPublish = document.getElementById('btn-publish');
  if (btnPublish) {
    btnPublish.addEventListener('click', async function() {
      if (!confirm('Terbitkan artikel ke blog publik?')) return;
      try {
        await doAction('/publish', {});
        window.location.reload();
      } catch(e) { showError('publish-error', e.message); }
    });
  }

  // Archive
  const btnArchive = document.getElementById('btn-archive');
  if (btnArchive) {
    btnArchive.addEventListener('click', async function() {
      if (!confirm('Arsipkan artikel ini?')) return;
      try {
        await doAction('/archive', {});
        window.location.reload();
      } catch(e) { showError('manage-error', e.message); }
    });
  }

  // Unpublish
  const btnUnpublish = document.getElementById('btn-unpublish');
  if (btnUnpublish) {
    btnUnpublish.addEventListener('click', async function() {
      if (!confirm('Cabut publikasi artikel ini?')) return;
      try {
        await doAction('/unpublish', {});
        window.location.reload();
      } catch(e) { showError('manage-error', e.message); }
    });
  }
})();
</script>
{% endblock %}
