  <!-- ═══════════════════════════════════════════════════
       CARA PEMBIAYAAN
       ═══════════════════════════════════════════════════ -->
  <section class="section" id="cara-daftar" aria-labelledby="cara-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cara Mendaftar</p>
        <h2 class="section-title" id="cara-title">Dua jalur, satu tujuan.</h2>
        <p class="section-lead">Pilih jalur yang sesuai. Semua proses dilakukan daring melalui portal ISF.</p>
      </div>

      <div class="pembiayaan-tracks">

        <div class="pembiayaan-track pembiayaan-track--scholarship" data-reveal>
          <div class="pembiayaan-track__header">
            <span class="pembiayaan-track__badge pembiayaan-track__badge--green" aria-hidden="true">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342"/></svg>
            </span>
            <div>
              <div class="pembiayaan-track__jalur">Jalur 1 · Gratis</div>
              <h3 class="pembiayaan-track__name">Beasiswa Penuh</h3>
            </div>
          </div>
          <ol class="steps">
            <li class="step"><span class="step__num" aria-hidden="true">1</span><div><h3 class="step__title">Buat akun portal</h3><p class="step__desc">Daftar dengan email kampus aktif.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">2</span><div><h3 class="step__title">Lengkapi profil mahasiswa</h3><p class="step__desc">Data diri, institusi, dan IPK terkini.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">3</span><div><h3 class="step__title">Unggah berkas pendukung</h3><p class="step__desc">KTM, transkrip, surat aktif, dan bukti prestasi.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">4</span><div><h3 class="step__title">Tulis esai motivasi</h3><p class="step__desc">600 kata tentang tujuan akademik dan dampak yang ingin dibuat.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">5</span><div><h3 class="step__title">Kirim lamaran</h3><p class="step__desc">Pastikan semua berkas lengkap sebelum submit.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">6</span><div><h3 class="step__title">Wawancara &amp; pengumuman</h3><p class="step__desc">Sesi 30 menit. Hasil dikirim paling lambat 31 Mar 2027.</p></div></li>
          </ol>
          <div style="margin-top:1.75rem;">
            <a class="btn btn--primary btn--sm" href="/auth/register">Daftar Beasiswa</a>
          </div>
        </div>

        <div class="pembiayaan-track pembiayaan-track--loan" data-reveal>
          <div class="pembiayaan-track__header">
            <span class="pembiayaan-track__badge pembiayaan-track__badge--blue" aria-hidden="true">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
            </span>
            <div>
              <div class="pembiayaan-track__jalur">Jalur 2 · Ada kewajiban pengembalian</div>
              <h3 class="pembiayaan-track__name">Pembiayaan Pendidikan</h3>
            </div>
          </div>
          <div class="pembiayaan-notice">
            <strong>Penting:</strong> Ini adalah pinjaman lunak. Cicilan dimulai 6 bulan setelah wisuda.
          </div>
          <ol class="steps">
            <li class="step"><span class="step__num" aria-hidden="true">1</span><div><h3 class="step__title">Buat akun portal</h3><p class="step__desc">Gunakan email aktif. Satu akun untuk semua layanan ISF.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">2</span><div><h3 class="step__title">Lengkapi profil &amp; berkas</h3><p class="step__desc">KTM, transkrip, kartu keluarga, surat penghasilan orang tua/wali.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">3</span><div><h3 class="step__title">Ajukan permohonan</h3><p class="step__desc">Tentukan jumlah yang dibutuhkan dan periode pembayaran.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">4</span><div><h3 class="step__title">Verifikasi &amp; perjanjian</h3><p class="step__desc">Tim ISF memverifikasi kelayakan, lalu penandatanganan digital.</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">5</span><div><h3 class="step__title">Pencairan dana</h3><p class="step__desc">Dana langsung ke rekening perguruan tinggi (UKT).</p></div></li>
            <li class="step"><span class="step__num" aria-hidden="true">6</span><div><h3 class="step__title">Cicilan pasca-studi</h3><p class="step__desc">Cicilan dimulai 6 bulan setelah lulus, disesuaikan penghasilan.</p></div></li>
          </ol>
          <div style="margin-top:1.75rem;">
            <a class="btn btn--blue btn--sm" href="/auth/register">Ajukan Pembiayaan</a>
          </div>
        </div>

      </div>
    </div>
  </section>

