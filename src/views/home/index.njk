  <!-- ═══════════════════════════════════════════════════
       BLOG & BERITA
       ═══════════════════════════════════════════════════ -->
  <section class="section section--blog" id="berita" aria-labelledby="berita-title">
    <div class="container">
      <div class="blog-section-head" data-reveal>
        <div>
          <p class="eyebrow">Blog &amp; Berita</p>
          <h2 class="section-title" id="berita-title">Cerita dari komunitas ISF.</h2>
          <p class="section-lead">Pengumuman beasiswa, cerita penerima, dan panduan pendidikan dari tim ISF.</p>
        </div>
        <div class="blog-section-head__nav">
          <a href="/blog" class="blog-cat-pill blog-cat-pill--active">Semua</a>
          <a href="/blog" class="blog-cat-pill">Berita ISF</a>
          <a href="/blog" class="blog-cat-pill">Beasiswa</a>
          <a href="/blog" class="blog-cat-pill">Cerita Penerima</a>
        </div>
      </div>

      {% if articles and articles.length > 0 %}
      <div class="blog-editorial-grid">
        <article class="blog-featured" data-reveal>
          {% if articles[0].coverImageUrl %}
          <div class="blog-featured__img">
            <img src="{{ articles[0].coverImageUrl }}" alt="{{ articles[0].title }}" loading="lazy">
          </div>
          {% else %}
          <div class="blog-featured__img blog-featured__img--placeholder" style="min-height:14rem;display:flex;align-items:center;justify-content:center;">
            <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" style="color:var(--hp-accent);opacity:0.4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg>
          </div>
          {% endif %}
          <div class="blog-featured__body">
            {% if articles[0].categories and articles[0].categories.length > 0 %}
            <span class="blog-cat-tag">{{ articles[0].categories[0].name }}</span>
            {% endif %}
            <h3 class="blog-featured__title">
              <a href="/blog/{{ articles[0].slug }}">{{ articles[0].title }}</a>
            </h3>
            {% if articles[0].summary %}
            <p class="blog-featured__summary">{{ articles[0].summary | truncate(140) }}</p>
            {% endif %}
            <div class="blog-featured__meta">
              <span>{{ articles[0].publishedAt | string | truncate(10, true, '') if articles[0].publishedAt else 'Baru-baru ini' }}</span>
            </div>
            <a href="/blog/{{ articles[0].slug }}" class="btn btn--primary btn--sm" style="margin-top:1.25rem;">Baca Selengkapnya →</a>
          </div>
        </article>

        <div class="blog-recent">
          <h3 class="blog-recent__heading">Artikel Terbaru</h3>
          <div class="blog-recent__list">
            {% for article in articles %}
            {% if loop.index > 1 and loop.index <= 4 %}
            <article class="blog-recent__item" data-reveal>
              {% if article.coverImageUrl %}
              <div class="blog-recent__thumb">
                <img src="{{ article.coverImageUrl }}" alt="{{ article.title }}" loading="lazy">
              </div>
              {% endif %}
              <div class="blog-recent__content">
                {% if article.categories and article.categories.length > 0 %}
                <span class="blog-cat-tag blog-cat-tag--sm">{{ article.categories[0].name }}</span>
                {% endif %}
                <h4 class="blog-recent__title">
                  <a href="/blog/{{ article.slug }}">{{ article.title }}</a>
                </h4>
                <time class="blog-recent__date">{{ article.publishedAt | string | truncate(10, true, '') if article.publishedAt else '' }}</time>
              </div>
            </article>
            {% endif %}
            {% endfor %}
          </div>
          <a href="/blog" class="btn btn--ghost btn--sm" style="margin-top:1.5rem;">Semua Artikel →</a>
        </div>
      </div>

      {% else %}
      <div class="blog-empty-state" data-reveal>
        <div class="blog-empty-state__inner">
          <div class="blog-empty-state__icon" aria-hidden="true">
            <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg>
          </div>
          <h3>Artikel Segera Hadir</h3>
          <p>Tim ISF sedang mempersiapkan konten terbaik untuk Anda.</p>
          <a href="/blog" class="btn btn--ghost btn--sm">Kunjungi Blog</a>
        </div>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       JADWAL SELEKSI
       ═══════════════════════════════════════════════════ -->
  <section class="section section--cream" id="jadwal" aria-labelledby="jadwal-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Jadwal Seleksi</p>
        <h2 class="section-title" id="jadwal-title">Lima tahap, empat bulan.</h2>
        <p class="section-lead">Seluruh proses berjalan daring. Wawancara akhir bisa dipilih daring atau luring.</p>
      </div>
      <ol class="timeline" data-reveal>
        <li class="timeline__item">
          <time class="timeline__date" datetime="2026-12-01">1 Des 2026 – 31 Jan 2027</time>
