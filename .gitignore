# ============================================================
# ISF Platform — .gitignore
# ============================================================

# --- Environment & Secrets ---------------------------------
.env
.env.*
!.env.example

# --- Dependencies ------------------------------------------
node_modules/

# --- Build output ------------------------------------------
dist/
build/

# --- Test coverage -----------------------------------------
coverage/
.nyc_output/

# --- Logs --------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Temporary files ---------------------------------------
*.tmp
*.temp
.cache/
tmp/

# --- OS / Editor -------------------------------------------
.DS_Store
Thumbs.db
.vscode/settings.json
.vscode/*.code-workspace
.idea/

# --- Tool-specific -----------------------------------------
.claude/
