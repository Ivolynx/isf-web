# ============================================================
# ISF Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://isf_user:your_password_here@localhost:5432/isf_db

# Session (generate with: openssl rand -base64 48)
SESSION_SECRET=replace_with_at_least_32_chars_random_secret_string

# SMTP (Mailhog for local dev, see docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@intelegensia.id

# File Storage (MinIO for local dev, see docker-compose.yml)
# For Railway: set STORAGE_ENDPOINT to your Railway Bucket endpoint,
#              set STORAGE_FORCE_PATH_STYLE=false (virtual-hosted-style).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=replace_with_local_storage_access_key
STORAGE_SECRET_ACCESS_KEY=replace_with_local_storage_secret_key
STORAGE_BUCKET_PRIVATE=isf-private-docs
STORAGE_BUCKET_PUBLIC=isf-public-assets
# true  = MinIO / local dev (path-style URLs)
# false = Railway Bucket / production (virtual-hosted-style)
STORAGE_FORCE_PATH_STYLE=true

# Payment Gateway
# Options: mock | midtrans | xendit
# DO NOT set to midtrans or xendit until credentials are ready.
PAYMENT_PROVIDER=mock

# Midtrans (only needed when PAYMENT_PROVIDER=midtrans)
# PAYMENT_MIDTRANS_SERVER_KEY=
# PAYMENT_MIDTRANS_CLIENT_KEY=

# Xendit (only needed when PAYMENT_PROVIDER=xendit)
# PAYMENT_XENDIT_SECRET_KEY=
# PAYMENT_XENDIT_WEBHOOK_TOKEN=

# Webhook signature secret for HMAC verification
# Generate with: openssl rand -hex 32
# Optional in development (unverified webhooks are accepted with a warning).
# REQUIRED in production.
# WEBHOOK_SECRET=replace_with_hex_secret_here

# WordPress Headless CMS (optional — application runs without it)
# Set WORDPRESS_BASE_URL to enable the homepage editor via WordPress Gutenberg.
# Development: Install WordPress Studio (https://developer.wordpress.com/studio/)
#              or use a local WordPress install (localhost:8888 etc.)
# WORDPRESS_BASE_URL=http://localhost:8888
# WORDPRESS_PAGE_SLUG=homepage
# WORDPRESS_CACHE_TTL=60

# Logging
LOG_LEVEL=info
